# ============================================================
# Lock & Key - Variáveis de Ambiente
# IMPORTANTE: Copiar para .env e NUNCA fazer commit do .env
# ============================================================

# --- Ambiente ---
APP_ENV=development
APP_URL=http://localhost/lockandkey/frontend
API_URL=http://localhost/lockandkey/backend/api

# --- Base de Dados MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lockandkey
DB_USER=root
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# --- JWT (Gerar com: php -r "echo bin2hex(random_bytes(64));") ---
JWT_SECRET=REPLACE_WITH_RANDOM_128_CHAR_HEX_STRING
JWT_ISSUER=lockandkey
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# --- Encriptação do servidor ---
# Chave AES-256 para dados auxiliares (NÃO é a chave do cofre)
# Gerar com: php -r "echo bin2hex(random_bytes(32));"
SERVER_ENCRYPT_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600

# --- Sessão ---
SESSION_TIMEOUT=1800
SESSION_NAME=lk_session

# --- Email (PHPMailer - opcional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@lockandkey.app
MAIL_PASS=your_email_password
MAIL_FROM_NAME=Lock & Key

# --- Segurança ---
BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
